<div class="flex min-h-screen flex-col bg-mbta">
  <main class="flex flex-1 flex-col px-4 py-8 sm:items-center sm:justify-center">
    <h1 class="mb-8 text-right font-display text-3xl font-black text-white sm:mb-10 sm:text-center sm:text-4xl">TripTrack</h1>

    <div class="w-full sm:max-w-md">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="mb-4">
          <%= f.label :email, class: "mb-1 block font-bold text-white" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field-input" %>
        </div>

        <div class="mb-4">
          <%= f.label :password, class: "mb-1 block font-bold text-white" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "field-input" %>
        </div>

        <% if devise_mapping.rememberable? -%>
          <div class="mb-6 flex items-center gap-2 text-white">
            <%= f.check_box :remember_me, class: "h-4 w-4" %>
            <%= f.label :remember_me, class: "font-sans" %>
          </div>
        <% end -%>

        <%= f.submit "Log in", class: "btn w-full bg-white !text-mbta hover:bg-gray-100 sm:w-auto sm:px-8" %>

        <div class="mt-6 text-white [&_a]:underline">
          <%= render "devise/shared/links" %>
        </div>
      <% end %>
    </div>
  </main>

  <footer class="flex items-center justify-end gap-3 bg-white px-4 py-3">
    <h3 class="font-sans text-black">powered by</h3>
    <img class="h-auto w-40 sm:w-56" src="/MassDOT_Logos.jpg" alt="MassDOT and MBTA logos" />
  </footer>
</div>
