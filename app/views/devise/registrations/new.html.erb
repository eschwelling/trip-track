<div class="flex min-h-screen flex-col bg-mbta">
  <main class="flex flex-1 flex-col px-4 py-8 sm:items-center sm:justify-center">
    <h1 class="mb-8 text-right font-display text-3xl font-black text-white sm:mb-10 sm:text-center sm:text-4xl">TripTrack</h1>

    <div class="w-full sm:max-w-md">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <div class="mb-4 text-white">
          <%= devise_error_messages! %>
        </div>

        <div class="mb-4">
          <%= f.label :user_name, "User Name", class: "mb-1 block font-bold text-white" %>
          <%= f.text_field :user_name, autofocus: true, autocomplete: "user_name", class: "field-input" %>
        </div>

        <div class="mb-4">
          <%= f.label :first_name, "First Name", class: "mb-1 block font-bold text-white" %>
          <%= f.text_field :first_name, autocomplete: "first_name", class: "field-input" %>
        </div>

        <div class="mb-4">
          <%= f.label :last_name, "Last Name", class: "mb-1 block font-bold text-white" %>
          <%= f.text_field :last_name, autocomplete: "last_name", class: "field-input" %>
        </div>

        <div class="mb-4">
          <%= f.label :email, class: "mb-1 block font-bold text-white" %>
          <%= f.email_field :email, autocomplete: "email", class: "field-input" %>
        </div>

        <div class="mb-4">
          <%= f.label :password, class: "mb-1 block font-bold text-white" %>
          <% if @minimum_password_length %>
            <em class="mb-1 block text-sm text-white">(<%= @minimum_password_length %> characters minimum)</em>
          <% end %>
          <%= f.password_field :password, autocomplete: "new-password", class: "field-input" %>
        </div>

        <div class="mb-4">
          <%= f.label :password_confirmation, "Password Confirmation", class: "mb-1 block font-bold text-white" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "field-input" %>
        </div>

        <div class="mb-6">
          <%= f.label :profile_photo, "Upload Profile Photo (Optional)", class: "mb-1 block font-bold text-white" %>
          <%= f.file_field :profile_photo, class: "block w-full text-white file:mr-3 file:rounded-full file:border-0 file:bg-white file:px-4 file:py-1 file:text-mbta" %>
        </div>

        <%= f.submit "Sign up", class: "btn w-full bg-white !text-mbta hover:bg-gray-100 sm:w-auto sm:px-8" %>

        <div class="mt-6 text-white [&_a]:underline">
          <%= render "devise/shared/links" %>
        </div>
      <% end %>
    </div>
  </main>

  <footer class="flex items-center justify-end gap-3 bg-white px-4 py-3">
    <h3 class="font-sans text-black">powered by</h3>
    <img class="h-auto w-40 sm:w-56" src="/MassDOT_Logos.jpg" alt="MassDOT and MBTA logos" />
  </footer>
</div>
